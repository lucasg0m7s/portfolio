---
import TechIcon from "@/components/TechIcon.astro";
import { techSlug } from "@/data/tech";
import { cn } from "@/lib/utils";

type Props = { items: string[]; class?: string };

const { items, class: className } = Astro.props;
---

<ul class={cn("flex flex-wrap gap-1.5", className)} aria-label="Tecnologias">
  {items.map((name) => (
    <li class="inline-flex items-center gap-1.5 rounded-sm border bg-background px-2 py-1 font-mono text-[0.72rem] text-muted-foreground">
      <TechIcon slug={techSlug(name)} name={name} class="size-3.5" />
      {name}
    </li>
  ))}
</ul>
