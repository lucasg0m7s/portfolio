---
import { cn } from "@/lib/utils";

type Props = {
  steps: string[];
  class?: string;
};

const { steps, class: className } = Astro.props;
---

<ol class={cn("relative font-mono text-[0.8rem]", className)} aria-label="Fluxo do sistema">
  {steps.map((step, index) => (
    <li class="relative grid grid-cols-[1.75rem_1fr] items-center gap-3 py-2">
      {index < steps.length - 1 && (
        <span
          class="absolute top-[calc(50%+0.875rem)] left-[0.875rem] h-[calc(100%-1.75rem)] w-px bg-border"
          aria-hidden="true"
        />
      )}
      <span class="grid size-7 place-items-center rounded-full border bg-card text-[0.7rem] text-primary">
        {index + 1}
      </span>
      <span>{step}</span>
    </li>
  ))}
</ol>
