---
import { cn } from "@/lib/utils";
import Icon from "@/components/Icon.astro";
import { buttonVariants } from "@/components/ui/button";
---

<button
  type="button"
  class={cn(buttonVariants({ variant: "ghost", size: "icon" }), "size-9")}
  data-theme-toggle
  aria-label="Alternar tema claro e escuro"
>
  <Icon name="sun" class="hidden size-[18px] dark:block" />
  <Icon name="moon" class="size-[18px] dark:hidden" />
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch {
        // Sem storage (modo privado restrito): o tema vale só para esta visita.
      }
    });
  });
</script>
