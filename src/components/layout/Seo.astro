---
import { profile, site } from "@/data/profile";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>;
};

const {
  title,
  description = site.description,
  image = "/og.png",
  type = "website",
  jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} · ${profile.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.fullName,
  alternateName: profile.name,
  jobTitle: `${profile.role} · ${profile.focus}`,
  url: Astro.site?.toString(),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Nova Odessa",
    addressRegion: "SP",
    addressCountry: "BR",
  },
  sameAs: [profile.social.github, profile.social.linkedin],
  knowsAbout: [
    "Engenharia de software",
    "Back-end",
    "IA generativa",
    "LLM",
    "Arquitetura de software",
    "Segurança de aplicações",
  ],
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="author" content={profile.fullName} />

<meta property="og:type" content={type} />
<meta property="og:locale" content={site.locale} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd ?? person)} />
