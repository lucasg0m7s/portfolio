---
import { cn } from "@/lib/utils";
import { Image } from "astro:assets";
import photo from "@/assets/profile.png";
import Icon from "@/components/Icon.astro";
import { buttonVariants } from "@/components/ui/button";
import { profile } from "@/data/profile";
import TechIcon from "@/components/TechIcon.astro";
import { strengths } from "@/data/skills";

const socials = [
  { label: "GitHub", href: profile.social.github, icon: "github" },
  { label: "LinkedIn", href: profile.social.linkedin, icon: "linkedin" },
  { label: "E-mail", href: `mailto:${profile.email}`, icon: "mail" },
] as const;
---

<section id="inicio" aria-labelledby="inicio-titulo" class="relative">
  <div class="container-page grid gap-12 pt-12 pb-16 sm:pt-16 lg:grid-cols-[minmax(0,1fr)_380px] lg:items-end lg:gap-16 lg:pb-20">
    <div class="flex min-w-0 flex-col">
      <p class="meta enter" style="--i:0">
        Desenvolvedor júnior na Diletta Solutions
      </p>

      <h1
        id="inicio-titulo"
        class="display mt-5 text-[clamp(3rem,7vw,5.25rem)] leading-[0.98] font-semibold tracking-[-0.035em]"
      >
        <span class="block overflow-hidden pb-[0.06em]">
          <span class="rise-word" style="--i:1">
            Lucas
          </span>
        </span>
        <span class="block overflow-hidden pb-[0.06em]">
          <span class="rise-word" style="--i:2">
            Gomes
          </span>
        </span>
      </h1>

      <p
        class="enter mt-7 max-w-[34ch] text-[clamp(1.25rem,2vw,1.5rem)] leading-snug font-medium text-balance"
        style="--i:4"
      >
        Sou desenvolvedor full stack, mais à vontade no back-end.
      </p>
      <p class="enter mt-3 max-w-[54ch] text-muted-foreground" style="--i:5">
        Trabalho com canais digitais de bancos e passo por API, integração, tela e deploy. Fora do
        trabalho, gosto de construir produtos com IA e de pensar com cuidado no que o modelo pode
        fazer.
      </p>

      <div class="enter mt-9 flex flex-wrap items-center gap-3" style="--i:6">
        <a href="#projetos" class={cn(buttonVariants({ size: "lg" }), "rounded-full px-6")}>
          Ver projetos
        </a>
        <ul class="ml-1 flex items-center gap-1" aria-label="Redes">
          {socials.map((social) => (
            <li>
              <a
                href={social.href}
                target={social.icon === "mail" ? undefined : "_blank"}
                rel={social.icon === "mail" ? undefined : "noopener noreferrer"}
                aria-label={social.label}
                class="grid size-11 place-items-center rounded-full text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
              >
                <Icon name={social.icon} class="size-[19px]" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <figure class="enter mx-auto w-full max-w-[380px] lg:mx-0" style="--i:3">
      <div class="overflow-hidden rounded-md bg-muted shadow-[0_30px_60px_-30px_rgb(20_10_40/0.45)]">
        <Image
          src={photo}
          alt="Retrato de Lucas Gomes, de camisa preta, em fundo cinza"
          widths={[380, 570, 760]}
          sizes="(min-width: 1024px) 380px, 90vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full object-cover object-[50%_20%] transition-transform duration-700 hover:scale-[1.02]"
        />
      </div>
      <figcaption class="meta mt-3 flex flex-wrap justify-between gap-x-4 gap-y-1">
        <span>{profile.fullName}</span>
        <span>Nova Odessa, SP</span>
      </figcaption>
    </figure>
  </div>

  <div class="border-y">
    <ul class="container-page grid sm:grid-cols-2 lg:grid-cols-4" aria-label="No que sou bom">
      {strengths.map((item, index) => (
        <li
          class:list={[
            "group flex flex-col gap-3 py-7 sm:pr-6",
            index > 0 && "border-t sm:border-t-0",
            index % 2 === 1 && "sm:border-l sm:pl-6",
            index === 2 && "sm:border-t lg:border-t-0 lg:border-l lg:pl-6",
            index === 3 && "sm:border-t lg:border-t-0",
          ]}
        >
          <div class="flex items-start justify-between gap-3">
            <h2 class="text-lg font-semibold">{item.title}</h2>
            <span class="flex items-center gap-2 text-muted-foreground" aria-hidden="true">
              {item.icons.map((slug) => (
                <TechIcon
                  slug={slug}
                  name={slug}
                  class="size-4 transition-colors group-hover:text-primary"
                />
              ))}
            </span>
          </div>
          <p class="text-[0.95rem] leading-relaxed text-muted-foreground">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
