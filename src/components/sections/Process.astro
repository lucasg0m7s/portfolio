---
import Section from "@/components/Section.astro";
import { processSteps } from "@/data/process";
---

<Section
  id="como-trabalho"
  title="Como trabalho"
  note="o mesmo ciclo em todo projeto"
  description="Uso Claude Code todos os dias. Para não perder o controle do que está sendo feito, sigo sempre estes quatro passos."
>
  <ol class="grid gap-x-12 gap-y-10 sm:grid-cols-2">
    {processSteps.map((item) => (
      <li class="grid grid-cols-[2rem_1fr] gap-4 border-t pt-6">
        <span class="font-mono text-sm leading-7 text-primary">{item.step}</span>
        <div>
          <h3 class="text-lg font-semibold">{item.title}</h3>
          <p class="mt-2 text-muted-foreground">{item.text}</p>
        </div>
      </li>
    ))}
  </ol>
</Section>
