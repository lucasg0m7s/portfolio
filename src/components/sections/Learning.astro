---
import Section from "@/components/Section.astro";
import TechIcon from "@/components/TechIcon.astro";
import { learning } from "@/data/skills";
---

<Section
  id="aprendendo"
  title="O que estou aprendendo"
  note="2026 — 2027"
  description={learning.description}
>
  <ol class="grid gap-5 sm:grid-cols-2">
    {learning.tracks.map((track) => (
      <li class="flex flex-col gap-3 rounded-lg border bg-card p-6">
        <div class="flex items-start justify-between gap-4">
          <h3 class="text-lg font-semibold">{track.title}</h3>
          <span class="meta shrink-0 pt-1">{track.where}</span>
        </div>
        <p class="text-[0.95rem] text-muted-foreground">{track.text}</p>
        {track.items.length > 0 && (
          <ul class="mt-auto flex flex-wrap gap-2 pt-2" aria-label="Tecnologias">
            {track.items.map((item) => (
              <li class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm">
                <TechIcon slug={item.slug} name={item.name} class="size-3.5 text-primary" />
                {item.name}
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>
</Section>
